{
  "name": "hermes-tb2-fix-git-x4-deepseek-k8s-pods",
  "versions_file": "../configs/versions.json",
  "overrides_file": "",
  "execution": {
    "concurrency": 4
  },
  "benchmark": {
    "type": "terminalbench2",
    "root": ".cache/terminal-bench-2-1",
    "tasks": [
      "fix-git",
      "fix-git",
      "fix-git",
      "fix-git"
    ]
  },
  "harness": {
    "type": "hermes",
    "deployment": {
      "backend": "kubernetes",
      "kubernetes": {
        "namespace": "aries",
        "images": {
          "aries-local/hermes": "docker.io/jingxiang212/aries-hermes"
        }
      }
    }
  },
  "sandbox": {
    "deployment": {
      "backend": "kubernetes",
      "kubernetes": {
        "namespace": "aries",
        "pod_cidr": "192.168.0.0/16",
        "service_cidr": "10.96.0.0/12"
      }
    }
  },
  "bridge": {
    "deployment": {
      "backend": "kubernetes",
      "kubernetes": {
        "namespace": "aries",
        "service_account": "aries-bridge",
        "images": {
          "aries-bridge": "docker.io/jingxiang212/aries-bridge"
        }
      }
    },
    "type": "hermes-ssh",
    "mode": "managed"
  },
  "runtime": {
    "backend": "deepseek",
    "mode": "external"
  },
  "model": {
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "id": "deepseek-flash",
    "reasoning_effort": "low"
  },
  "output_dir": "runs"
}
