# Dedicated containerd for aries-vmd. Generated by scripts/vmd/install.sh;
# it does not share state with Docker's containerd.
version = 3
root = "/var/lib/aries-containerd"
state = "/run/aries-containerd"
disabled_plugins = ["io.containerd.grpc.v1.cri", "io.containerd.cri.v1.runtime", "io.containerd.cri.v1.images"]

[grpc]
  address = "/run/aries-containerd/containerd.sock"

[ttrpc]
  address = "/run/aries-containerd/containerd.sock.ttrpc"

[plugins]
  [plugins.'io.containerd.snapshotter.v1.devmapper']
    pool_name = "@POOL_NAME@"
    root_path = "/var/lib/aries-containerd/devmapper"
    base_image_size = "@STORAGE_LIMIT_MB@MB"
    discard_blocks = true
    fs_type = "ext4"
